              <name>BITS_16_18_OPAQUE</name>
              <description>Opaque: meaning not established. Masked event bits whose identities remain unknown.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>TX_TIMEOUT</name>
              <description>Project-assigned name. Hardware TX queue timeout/abort event.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BIT_20_OPAQUE</name>
              <description>Opaque: meaning not established. Masked event bit whose identity remains unknown.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BIT_21_OPAQUE</name>
              <description>Opaque: meaning not established. Masked event bit enabled by the complete cold receive mask; its event identity remains unknown.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BIT_22_OPAQUE</name>
              <description>Opaque: meaning not established. Masked event bit whose identity remains unknown.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BIT_23_OPAQUE</name>
              <description>Opaque: meaning not established. Masked event bit enabled by the complete cold receive mask; its event identity remains unknown.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
