    <peripheral>
      <name>WIFI_MAC_LOCAL_TIME</name>
      <description>Free-running Wi-Fi MAC local-time counter, read-only and without read side
        effects. Complete libpp[lmac.o]::lmacAdjustTimestamp subtracts the receive timestamp
        a received frame carries from this word as the frame's age and, while
        the station slept, rewrites that timestamp as this word minus a
        TU-scaled sleep interval; libpp[pm_twt.o]::pm_twt_set_target_wdev_time,
        libpp[pm_coex.o]::pm_get_null_max_tx_time and libpp[pm_coex.o]::pm_coex_recalculate_wifi_time_slice read
        it as the MAC's current time. The PHY SDM deadline samples the same
        word. Its unit and rate against the system timer are not
        established.</description>
      <baseAddress>0x2010D800</baseAddress>
      <registers>
        <register>
          <name>COUNTER</name>
          <description>Project-assigned name. The MAC local-time counter. Complete phy_wait_i2c_sdm_stable samples it before and after each independently completed PHY-I2C read.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>VALUE</name>
              <description>Project-assigned name. Full-width wrapping counter value in microseconds, at the system timer's rate; receive timestamps are readings of it.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PHY_CLOCK_ORACLE</name>
      <description>OPAQUE PHY clock-gate
        registers recovered from complete no-call ROM/blob leaves.</description>
      <baseAddress>0x20100000</baseAddress>
      <registers>
        <register>
          <name>WORD_0400_OPAQUE</name>
          <description>Opaque: meaning not established. ROM writes 0x1e7 to open and the blob writes zero to close.</description>
          <addressOffset>0x400</addressOffset>
          <size>0x20</size>
          <access>write-only</access>
          <fields>
            <field>
              <name>STATE</name>
              <description>Project-assigned name. Complete observed front-end clock-gate images; constituent gate meanings remain unknown.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>CLOSED</name>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OPEN</name>
                  <value>487</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>TABLE_MEMORY_INDEX_SOURCE</name>
          <description>Project-assigned name. Shared word contains the table-memory base index and the complete phy_force_pwr_index controls.</description>
          <addressOffset>0x408</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FORCED_DIGITAL_GAIN_0</name>
              <description>Project-assigned name.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>FORCED_DIGITAL_GAIN_1</name>
              <description>Project-assigned name.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>FORCE_DIGITAL_GAIN_ENABLE</name>
              <description>Project-assigned name.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FORCED_POWER_INDEX</name>
              <description>Project-assigned name. Complete phy_force_pwr_index replaces bits 22:17 with the low six bits of its second argument.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>6</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>63</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>FORCE_POWER_ENABLE</name>
              <description>Project-assigned name. Complete phy_force_pwr_index replaces bit 23 with the low bit of its first argument.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BASE_INDEX</name>
              <description>Project-assigned name. Eight-bit table-memory base index; the complete front-end initializer writes 0xa0.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>WORD_0800_OPAQUE</name>
          <description>Opaque: meaning not established. ROM sets bits 1:0 and the blob clears them.</description>
          <addressOffset>0x800</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BITS_0_1_OPAQUE</name>
              <description>Opaque: meaning not established. Two-bit open/close mask; individual meanings are unknown.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>CLOSED</name>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OPEN</name>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BIT_2_OPAQUE</name>
              <description>Opaque: meaning not established. The phy_bb_init parent sets bit 2 before calibration; the individual hardware meaning remains unknown.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>WORD_7C80_OPAQUE</name>
          <description>Opaque: meaning not established. ROM writes all ones to open and the blob writes zero to close.</description>
          <addressOffset>0x7C80</addressOffset>
          <size>0x20</size>
          <access>write-only</access>
          <fields>
            <field>
              <name>STATE</name>
              <description>Project-assigned name. Complete observed baseband clock-gate images; constituent gate meanings remain unknown.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>CLOSED</name>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OPEN</name>
                  <value>4294967295</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PMU_RADIO</name>
      <description>Route-owned PMU words used by the reviewed shared radio clock, RF-power and analog-I2C lifecycles. Unrelated PMU words remain platform-owned.</description>
      <baseAddress>0x20704000</baseAddress>
      <registers>
        <register>
          <name>HP_ACTIVE_ICG_MODEM</name>
          <description>Active-state modem clock-gating selection.</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>HP_ACTIVE_DIG_ICG_MODEM_CODE</name>
              <description>Two-bit active-state modem clock-gating code; official ESP-HAL publishes code two for the active configuration.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <name>ActiveModemIcgCode</name>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>ACTIVE</name>
                  <description>Active-state modem clock-gating code published by official ESP-HAL.</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HP_ACTIVE_HP_CK_POWER</name>
          <description>Active-state high-power clock and analog-I2C power control reached by the complete front-end/baseband clock body.</description>
          <addressOffset>0x1C</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>BITS_0_3_OPAQUE</name>
              <description>Opaque: meaning not established. Low-nibble image set by complete rev0 ROM phy_open_fe_bb_clk; individual bit semantics remain unknown.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <name>FrontEndBasebandClockImage</name>
                <usage>write</usage>
                <enumeratedValue>
                  <name>ROM_REQUIRED</name>
                  <description>Complete low-nibble image published by the rev0 ROM front-end/baseband clock leaf.</description>
                  <value>15</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HP_ACTIVE_XPD_BB_I2C</name>
              <description>Active-state baseband analog-I2C power control.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IMM_HP_CK_POWER_0</name>
          <description>Immediate high-power clock ties. The reviewed complete PHY body reads this word before its preserving update, overriding the write-only access class in the uncorrected public SVD.</description>
          <addressOffset>0xF0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>TIE_HIGH_XPD_BB_I2C</name>
              <description>Force the baseband analog-I2C power control high.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TIE_HIGH_XPD_XTALX2</name>
              <description>Force the doubled-crystal power control high.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TIE_HIGH_XPD_XTAL</name>
              <description>Force the crystal power control high.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IMM_SLEEP_SYSCLK</name>
          <description>Immediate sleep/system-clock update commands.</description>
          <addressOffset>0xF8</addressOffset>
          <size>0x20</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>UPDATE_DIG_ICG_SWITCH</name>
              <description>Publish the selected digital clock-gating switch state.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IMM_MODEM_ICG</name>
          <description>Immediate modem clock-gating update command.</description>
          <addressOffset>0x104</addressOffset>
          <size>0x20</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>UPDATE_DIG_ICG_MODEM_EN</name>
              <description>Publish the selected digital modem clock-gating state.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RF_PWC</name>
          <description>RF circuit power control.</description>
          <addressOffset>0x184</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>XPD_RF_CIRCUIT</name>
              <description>Sixteen RF circuit power-control bits.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <name>RfCircuitPower</name>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>POWERED_OFF</name>
                  <description>Clear every reviewed RF circuit power-control bit.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POWERED_ON</name>
                  <description>Set every reviewed RF circuit power-control bit.</description>
                  <value>65535</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ANA_PERI_PWR_CTRL</name>
          <description>Analog peripheral I2C power and active-low reset control.</description>
          <addressOffset>0x208</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x40000000</resetValue>
          <fields>
            <field>
              <name>XPD_PERIF_I2C</name>
              <description>Analog peripheral I2C power control.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSTB_PERIF_I2C</name>
              <description>Analog peripheral I2C active-low reset release.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
