        <register>
          <name>TX_BLOCK_ACK_BITMAP_HIGH_Q7</name>
          <description>Project-assigned name. WDEVTXQBA_BMHI for reverse-addressed hardware queue 7.</description>
          <addressOffset>0x11C4</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
