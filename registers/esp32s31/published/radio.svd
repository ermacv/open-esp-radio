              </enumeratedValues>
            </field>
            <field>
              <name>BITS_8_15_OPAQUE</name>
              <description>Opaque: meaning not established. Complete hal_init replaces bits 15:8 with one through a separate RMW.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>INITIALIZED</name>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BIT_27_OPAQUE</name>
              <description>Opaque: meaning not established. Final set edge of mac_last_rxbuf_init; its narrower interaction with CSI is unknown.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
