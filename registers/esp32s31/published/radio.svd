        <register>
          <name>PAON_DELAY</name>
          <description>Power-amplifier-on delay. The pinned public driver and LL never write it; the reset value applies unless another owner does. Physical units remain outside the PAC.</description>
          <addressOffset>0x100</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>PAON_DELAY</name>
              <description>Ten-bit power-amplifier-on delay.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
            </field>
            <field>
              <name>BITS_10_31_OPAQUE</name>
              <description>Opaque: meaning not established. Bits the vendor declares reserved (reserved10), read so a hardware comparison sees the complete word; the vendor image holds nonzero values here in PAON_DELAY and RXON_DELAY.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>22</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TXEN_STOP_DELAY</name>
          <description>Transmit-enable stop delay. The pinned public driver and LL never write it; physical units remain outside the PAC.</description>
          <addressOffset>0x108</addressOffset>
