          <access>read-write</access>
          <fields>
            <field>
              <name>BITS_12_24_OPAQUE</name>
              <description>Opaque: meaning not established. Thirteen-bit low reset group cleared by complete phy_fe_txrx_reset.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>13</bitWidth>
            </field>
            <field>
              <name>TX_RX_RESET_BIT_25</name>
              <description>Project-assigned name. First upper reset bit asserted by complete phy_fe_txrx_reset.</description>
