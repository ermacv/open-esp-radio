    <peripheral>
      <name>PHY_FECOEX_RECOVERED</name>
      <description>Sparse FECOEX words absent from the public platform PAC.</description>
      <baseAddress>0x20100000</baseAddress>
      <registers>
        <register>
          <name>BT_COEX_PTI_CONFIG</name>
          <description>Project-assigned name. Complete coex_pti_v2 performs two ordered fresh-read RMW operations: it first replaces bits 31:16 with 0x0640, then replaces bits 15:0 with 0x0010. Individual bit meanings remain unknown.</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BITS_0_15_OPAQUE</name>
              <description>Opaque: meaning not established. Fixed 0x0010 image published by the second coex_pti_v2 RMW.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <name>LOW_IMAGE</name>
                <usage>write</usage>
                <enumeratedValue>
                  <name>REVIEWED_IMAGE</name>
                  <description>The only low-halfword image proved by coex_pti_v2.</description>
                  <value>16</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BITS_16_31_OPAQUE</name>
              <description>Opaque: meaning not established. Fixed 0x0640 image published by the first coex_pti_v2 RMW.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <name>HIGH_IMAGE</name>
                <usage>write</usage>
                <enumeratedValue>
                  <name>REVIEWED_IMAGE</name>
                  <description>The only high-halfword image proved by coex_pti_v2.</description>
                  <value>1600</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PHY_FEDATA_RECOVERED</name>
