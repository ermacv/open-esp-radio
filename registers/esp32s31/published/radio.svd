        <register>
          <name>STATUS</name>
          <description>Project-assigned name. Masked WDEVPWR event image returned by complete hal_pwr_interrupt_get_event, with TSF timer causes identified by the guarded timer leaves.</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>TBTT_3</name>
              <description>Project-assigned name. Masked TSF-3 TBTT event.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TBTT_2</name>
