          <fields>
            <field>
              <name>ORDINARY_ENTRY_UPDATE</name>
              <description>Project-assigned name. One update bit per reverse-addressed ordinary receive BlockAck bank. Complete add/reset performs a fresh-read OR with one shifted by the logical hardware index.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>EXTRA_SOFTAP_COMMIT</name>
              <description>Project-assigned name. Complete extra-SoftAP add/reset/delete pulses this bit high then low after filling the shared staging words.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXTRA_SOFTAP_READBACK_LATCH</name>
              <description>Project-assigned name. Complete extra-SoftAP diagnostics, reset and delete set this bit while reading the entry selected in the staging control and clear it afterwards.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EXTRA_SOFTAP_RX_BLOCK_ACK_CONTROL</name>
          <description>Project-assigned name. Shared staging and readback-control word used only by complete hal_agreement_*_extra_softap_rx_ba leaves. Ordinary STA/AP receive BlockAck agreements use the eight direct banks at 0x20104178..0x20104294 instead.</description>
          <addressOffset>0xEA4</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Project-assigned name.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BITS_1_4_OPAQUE</name>
              <description>Opaque: meaning not established. Bits cleared by every reviewed zero-based extra-SoftAP control publication.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>INDEX</name>
              <description>Project-assigned name.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>5</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>31</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>BITS_10_11_OPAQUE</name>
              <description>Opaque: meaning not established. Bits cleared by every reviewed zero-based extra-SoftAP control publication.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>TID</name>
              <description>Project-assigned name.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>15</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>BITS_16_29_OPAQUE</name>
              <description>Opaque: meaning not established. Bits cleared by every reviewed zero-based extra-SoftAP control publication.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>14</bitWidth>
            </field>
            <field>
              <name>WRITE</name>
              <description>Project-assigned name.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VALID</name>
              <description>Project-assigned name.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EXTRA_SOFTAP_RX_BLOCK_ACK_PEER_TAIL_AND_POLICY</name>
          <description>Project-assigned name. Shared extra-SoftAP staging word carrying peer MAC bytes four and five, interface and reorder-window size.</description>
          <addressOffset>0xEA8</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>PEER_ADDRESS_TAIL</name>
              <description>Project-assigned name.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>65535</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>INTERFACE</name>
              <description>Project-assigned name.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>3</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>WINDOW</name>
              <description>Project-assigned name.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>7</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>127</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>BITS_25_31_OPAQUE</name>
              <description>Opaque: meaning not established. Bits cleared by every reviewed zero-based extra-SoftAP policy publication.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EXTRA_SOFTAP_RX_BLOCK_ACK_PEER_HEAD</name>
          <description>Project-assigned name. Shared extra-SoftAP staging word carrying peer MAC bytes zero through three in little-endian order.</description>
          <addressOffset>0xEAC</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>PEER_ADDRESS_HEAD</name>
              <description>Project-assigned name. Peer MAC address bytes zero through three in little-endian order.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>4294967295</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>EXTRA_SOFTAP_RX_BLOCK_ACK_START_SEQUENCE</name>
          <description>Project-assigned name. Shared extra-SoftAP staging word carrying the twelve-bit starting sequence.</description>
          <addressOffset>0xEB0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SEQUENCE</name>
              <description>Project-assigned name.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>4095</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>EXTRA_SOFTAP_RX_BLOCK_ACK_BITMAP_LOW</name>
          <description>Project-assigned name. Shared extra-SoftAP low receive/reorder bitmap staging word, cleared when installing or removing an entry.</description>
          <addressOffset>0xEB4</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
