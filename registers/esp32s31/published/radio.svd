        <register>
          <name>WORD_0540_OPAQUE</name>
          <description>Opaque: meaning not established. BLE PHY register initialization writes the complete controller-configuration word at offset 0x40, which the pinned configuration defaults to 2000.</description>
          <addressOffset>0x540</addressOffset>
