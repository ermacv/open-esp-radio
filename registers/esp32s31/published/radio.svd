          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>STREAM_0_CODE</name>
              <description>Project-assigned name. Unsigned raw code. Values other than 0x7f convert to quarter-dB units after adding 88.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>BITS_8_31_OPAQUE</name>
              <description>Opaque: meaning not established.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WIFI_MAC_TX_COMPLETION</name>
      <description>Non-aliased words from four 0x7c-byte completion banks representing logical EDCA queues 3,2,1,0. AUX_A/AUX_B are canonically described by the richer TX BlockAck high-address and TX queue-information registers in WIFI_MAC_RX_DMA.</description>
      <baseAddress>0x201053B0</baseAddress>
      <registers>
        <register>
          <dim>4</dim>
          <dimIncrement>0x7C</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <name>PRIMARY%s</name>
          <description>Project-assigned name. Primary completion/status word. Complete libpp[hal_mac_tx.o]::hal_mac_get_txq_complete copies bits 23:16 to result byte two independently of the primary/alternate status selector; complete libpp[lmac.o]::lmacProcessTxSuccess stores that byte as encoded ACK SNR.</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>DETAIL</name>
              <description>Project-assigned name. Low completion detail byte passed by complete libpp[lmac.o]::lmacProcessTxComplete to the status-one/status-four secondary dispatchers when PRIMARY is selected.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>STATUS</name>
              <description>Project-assigned name. Four-bit top-level completion status selected by complete libpp[hal_mac_tx.o]::hal_mac_get_txq_complete and dispatched by complete libpp[lmac.o]::lmacProcessTxComplete.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>ACK_SNR_ENCODED</name>
              <description>Project-assigned name. Complete libpp[hal_mac_tx.o]::hal_mac_get_txq_complete copies PRIMARY bits 23:16 to result byte two. Complete libpp[lmac.o]::lmacProcessTxSuccess passes that byte into the descriptor ACK-SNR slot. Complete libpp[trc.o]::rcUpdateTxDone adds the pinned wDevCtrl byte 0x60 and narrows to a signed byte before libpp[trc.o]::rcUpdateAckSnr. This field is meaningful only for a successful completion.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>0x7C</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <name>ALTERNATE%s</name>
          <description>Project-assigned name. Alternate completion/status word selected by the recovered auxiliary bit.</description>
          <addressOffset>0x1C</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>DETAIL</name>
              <description>Project-assigned name. Low completion detail byte used by the status-one/status-four secondary dispatchers when the auxiliary selector chooses ALTERNATE.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>STATUS</name>
              <description>Project-assigned name. Four-bit top-level completion status used when the auxiliary selector chooses ALTERNATE.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>0x7C</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <name>AUX_C%s</name>
          <description>Project-assigned name. Third auxiliary completion word contributing to the second decoded extension image.</description>
          <addressOffset>0x28</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>SECONDARY_TRIGGER_BASED_PACKET_COUNT</name>
              <description>Project-assigned name. Complete libpp[hal_mac_tx.o]::hal_mac_get_txq_complete contributes AUX_C bits 13:7 to reconstructed extension word one; complete libpp[lmac.o]::lmacProcessTxComplete shifts that image right by two before storing the seven-bit secondary Trigger-based packet count.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WIFI_MAC_HE_INIT_PREFIX</name>
      <description>Complete hal_he_init prefix through hal_init_tb_tx, stopping immediately before hal_init_tx_pwr. Twenty-two separate RMW edges and one final synchronization/status read.</description>
      <baseAddress>0x20104048</baseAddress>
      <registers>
        <register>
          <name>RX_FIELD_CONTROL</name>
          <description>Project-assigned name. Canonical RX_HE_BSS_COLOR_CONF word. Complete dbg_read_color_collision names the fields; the HE init parent replaces TIMEOUT_SECONDS bits 8:3 with 0x3c. HE Operation programming sets COLOR_BITMAP_CLEAR to clear the accumulated BSS-color collision bitmap.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
