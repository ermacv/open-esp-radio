            <field>
              <name>TO_DS</name>
              <description>Project-assigned name.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FROM_DS</name>
              <description>Project-assigned name.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CHECK_BSSID</name>
              <description>Project-assigned name.</description>
