        <register>
          <name>IRQ_CONTROL_1</name>
          <description>Project-assigned name. BTDM interrupt teardown and the complete reset leaf write the finite complete image 1. Inner action remains unknown.</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <access>write-only</access>
          <fields>
            <field>
              <name>COMMAND</name>
              <description>Project-assigned name.</description>
