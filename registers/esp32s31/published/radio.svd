              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLK_COEX_LP_SEL_XTAL</name>
              <description>Select the crystal clock.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLK_COEX_LP_SEL_XTAL32K</name>
              <description>Select the 32 kHz crystal clock.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLK_COEX_LP_DIV_NUM</name>
              <description>Twelve-bit coexistence low-power clock divider image.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>12</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>4095</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>WIFI_LP_CLK_CONF</name>
          <description>Wi-Fi power-domain low-power source selector and twelve-bit divider.</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CLK_WIFIPWR_LP_SEL_OSC_SLOW</name>
