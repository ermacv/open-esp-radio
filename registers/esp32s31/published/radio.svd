              <description>Project-assigned name. Seven-bit descriptor byte 0x2e copied by complete libpp[hal_mac_tx.o]::mac_tx_set_htsig.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>7</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>127</maximum>
                </range>
              </writeConstraint>
