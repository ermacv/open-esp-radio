<?xml version="1.0" encoding="UTF-8"?>
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Espressif</vendor>
  <vendorID>ESP</vendorID>
  <name>ESP32S31_RADIO</name>
  <series>ESP32-S31</series>
  <version>3.52</version>
  <description>Recovered ESP32-S31 modem/radio core plus the minimum platform dependencies
    no longer delegated to an external platform PAC. Unclaimed MODEM_LPCON,
    PMU and HP_SYS_CLKRST words remain platform-owned.
    I2C_ANA_MST, PMU_RADIO, HP_SYS_CLKRST_RADIO, MODEM_SYSCON_RADIO, MODEM_LPCON_SHARED_CLOCK, MODEM_LPCON_PHY_TICK, LP_AON_CLKRST,
    LP_PERICLKRST and LP_TSENS are canonical reviewed radio-PHY dependencies.
    These are independently decoded
    MMIO windows, not one monolithic radio peripheral. Covered functions include PHY-PBus,
    PHY-I2C, IQ estimation, RX-DCO, cold deadlines, temperature sensing,
    Wi-Fi MAC RX-DMA and receive BlockAck. Unknown fields are omitted; OPAQUE
    and UNKNOWN names describe instruction-level evidence without assigning an
    unproven hardware meaning.</description>
  <licenseText>MIT OR Apache-2.0</licenseText>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <peripherals>
    <peripheral>
      <name>WIFI_MAC_INTERNAL_TX_BLOCK_ACK</name>
      <description>Complete dbg_read_internal_txba reads one internal WDEVTXBA result: a 64-bit bitmap, two transmitter-address words and a combined fragment/starting-sequence/TID word.</description>
      <baseAddress>0x2010429C</baseAddress>
      <registers>
        <register>
          <name>BITMAP_HIGH</name>
          <description>Project-assigned name.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>BITMAP</name>
              <description>Project-assigned name. High 32 bits of the internal transmit BlockAck acknowledgement bitmap.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>BITMAP_LOW</name>
          <description>Project-assigned name.</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>BITMAP</name>
              <description>Project-assigned name. Low 32 bits of the internal transmit BlockAck acknowledgement bitmap.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TRANSMITTER_ADDRESS_WORD_0</name>
          <description>Project-assigned name. First WDEVTXBA TA word printed by the complete blob decoder. Byte ordering is retained as a raw word until a matching live frame qualifies it.</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
        </register>
        <register>
          <name>TRANSMITTER_ADDRESS_WORD_1</name>
          <description>Project-assigned name. Second WDEVTXBA TA word printed by the complete blob decoder. Byte ordering is retained as a raw word until a matching live frame qualifies it.</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
        </register>
        <register>
          <name>CONTROL_SEQUENCE</name>
          <description>Project-assigned name.</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>FRAGMENT_NUMBER</name>
              <description>Project-assigned name.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>STARTING_SEQUENCE</name>
              <description>Project-assigned name.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>TID</name>
              <description>Project-assigned name.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WIFI_MAC_HE_COLOR_COLLISION</name>
      <description>Complete dbg_read_color_collision reads the 64-bit observed BSS-color bitmap. Its adjacent control word is the canonical WIFI_MAC_HE_INIT_PREFIX.RX_FIELD_CONTROL register. Open HE HIL observed color bit 25, threshold one and timeout 60 seconds.</description>
      <baseAddress>0x20104040</baseAddress>
      <registers>
        <register>
          <name>BSS_COLOR_BITMAP_LOW</name>
          <description>Project-assigned name. RX_HE_BSS_COLOR_MAPLO.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>VALUE</name>
              <description>Project-assigned name.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>BSS_COLOR_BITMAP_HIGH</name>
          <description>Project-assigned name. RX_HE_BSS_COLOR_MAPHI.</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>VALUE</name>
              <description>Project-assigned name.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WIFI_MAC_RX_POWER_SAVE</name>
