              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TSF_TIMER_3</name>
              <description>Project-assigned name. Masked guarded TSF timer-three event.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TSF_TIMER_2</name>
              <description>Project-assigned name. Masked guarded TSF timer-two event.</description>
