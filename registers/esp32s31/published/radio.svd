            <field>
              <name>TBTT_1</name>
              <description>Project-assigned name. Enable the TSF-1 TBTT event.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TBTT_0</name>
              <description>Project-assigned name. Enable the TSF-0 TBTT event. TSF 0 is the station TSF.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TSF_TIMER_3</name>
              <description>Project-assigned name. Enable the guarded TSF timer-three event.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
