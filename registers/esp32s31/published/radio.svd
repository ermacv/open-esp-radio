              <description>Opaque: meaning not established. The complete HE init parent sets bit 17 through a separate fresh-read RMW.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>NRX_FREQUENCY_CONTROL</name>
          <description>Project-assigned name. NRX initialization and frequency quotient word. Complete phy_nrx_freq_set samples and preserves the high byte and writes a twenty-four-bit quotient. Initialization writes the same complete low twenty-four-bit region with its own image.</description>
          <addressOffset>0x7848</addressOffset>
