    </peripheral>
    <peripheral>
      <name>WIFI_MAC_CONTROL</name>
      <description>Shared MAC run/stop control. The cold open-RX frontier publishes zero; the complete vendor channel-switch chain requests quiescence here and later restarts the no-power-save profile.</description>
      <baseAddress>0x20104CAC</baseAddress>
      <registers>
        <register>
          <name>CONTROL</name>
          <description>Project-assigned name. Cold promiscuous initialization writes zero. libpp[hal_mac.o]::hal_mac_deinit records bits 13 and 14 as TX/RX activity and sets bit 12 plus bits 23:16; hal_mac_init with WIFI_PS_NONE clears that same stop-request mask.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BITS_0_11_OPAQUE</name>
              <description>Opaque: meaning not established.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>NO_RETENTION_STOP_REQUEST</name>
              <description>Project-assigned name. Included in the MAC stop request and cleared by hal_mac_init for the WIFI_PS_NONE all-ones retention mask.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ACTIVE_STATE</name>
              <description>Project-assigned name. Three-bit activity state polled until zero before PHY retuning. libpp[hal_mac.o]::hal_mac_deinit independently records bit 13 as TX active and bit 14 as RX active; bit 15 remains unnamed.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TX_BLOCK_STOP_REQUEST_LOW</name>
              <description>Project-assigned name. Bit 16 of the eight stop-request bits libpp[hal_mac.o]::hal_mac_deinit sets and hal_mac_init clears with the WIFI_PS_NONE retention mask.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>POWER_SAVE_TX_BLOCK</name>
              <description>Project-assigned name. Bits 19:17 of the stop-request bits. The vendor power manager sets all three to block the TX queues when its coexistence slice ends and clears them to unblock; its retention mask keeps them out of the MAC deinit and init requests while an associated station runs power management.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>3</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <name>PowerSaveTxBlock</name>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>RUN</name>
                  <description>The TX queues run.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BLOCKED</name>
                  <description>The TX queues are blocked.</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TX_BLOCK_STOP_REQUEST_HIGH</name>
              <description>Project-assigned name. Bits 23:20 of the eight stop-request bits libpp[hal_mac.o]::hal_mac_deinit sets and hal_mac_init clears with the WIFI_PS_NONE retention mask.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>15</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>BITS_24_31_OPAQUE</name>
              <description>Opaque: meaning not established.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WIFI_MAC_REGDMA_CONTROL</name>
      <description>Shared WDEVPWR control word. The channel-change leaf proves the REGDMA selector, while complete modem-power leaves prove the wake-protect lead time and TBTT auto-period fields. Hardware interactions between these fields remain unqualified.</description>
      <baseAddress>0x2010D83C</baseAddress>
      <registers>
        <register>
          <name>CONTROL</name>
          <description>Project-assigned name. Shared REGDMA and modem wakeup configuration word. Every promoted field has a complete independent setter; their combined hardware lifecycle is not inferred.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>MODEM_WAKEUP_PROTECT_EARLY_TIME</name>
              <description>Project-assigned name. libpp[hal_pwr.o]::pwr_hal_set_mac_modem_state_wakeup_protect_early_time replaces the low sixteen bits.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>65535</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>BIT_16_OPAQUE</name>
              <description>Opaque: meaning not established.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ACTIVE_LINK</name>
              <description>Project-assigned name. Four-bit Wi-Fi MAC REGDMA link selector; the active no-power-save channel restart writes four. Leaving zero after retuning caused intermittent authentication ACK timeouts.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>4</bitWidth>
              <writeConstraint>
                <useEnumeratedValues>true</useEnumeratedValues>
              </writeConstraint>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>WIFI_NO_POWER_SAVE</name>
                  <description>REGDMA link selected by the qualified Wi-Fi no-power-save restart.</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MODEM_TBTT_AUTO_PERIOD_INTERVAL</name>
              <description>Project-assigned name. libpp[hal_pwr.o]::pwr_hal_set_mac_modem_tbtt_auto_period_interval replaces bits 30:21 from the low ten argument bits.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>10</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>1023</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>MODEM_TBTT_AUTO_PERIOD_ENABLE</name>
              <description>Project-assigned name. The dedicated enable and disable leaves set or clear bit 31.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WIFI_MAC_CRYPTO_CONTROL</name>
      <description>Per-interface hardware-crypto controls, shared policy mask and key
        validity bitmap recovered from complete libpp hal_crypto leaves.</description>
      <baseAddress>0x20104800</baseAddress>
      <registers>
        <register>
          <dim>3</dim>
          <dimIncrement>0x4</dimIncrement>
          <dimIndex>0-2</dimIndex>
          <name>INTERFACE_CONTROL%s</name>
          <description>Project-assigned name. STA, AP and NAN interface controls selected by hal_crypto_enable. Ordinary CCMP writes 0x00030103 and additionally enables SPP A-MSDU when the association negotiated it. SPP is shared by every key on this interface.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BITS_0_8_OPAQUE</name>
              <description>Opaque: meaning not established. Low algorithm and enable fields composed by hal_crypto_enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>511</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>SPP_AMSDU</name>
              <description>Project-assigned name. Authenticate the QoS A-MSDU-present bit in CCMP for this interface. SOURCE(esp32s31): libpp[hal_crypto.o]::hal_crypto_enable +0x2e..+0x34 consumes argument four from libpp[wdev.o]::wDev_Insert_KeyEntry; libnet80211[ieee80211_supplicant.o]::ieee80211_get_spp selects the association decision upstream.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BITS_10_29_OPAQUE</name>
              <description>Opaque: meaning not established. Upper algorithm and management-frame policy fields composed by hal_crypto_enable.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>20</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>1048575</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>BITS_30_31_OPAQUE</name>
              <description>Opaque: meaning not established. Complete ordinary enable clears both high bits; one algorithm branch sets bit 31.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>3</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>POLICY_CONTROL</name>
          <description>Project-assigned name. Shared policy word. The ordinary non-algorithm-four enable path preserves bits 31:22 and 5:0 while clearing bits 21:6.</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BITS_0_5_OPAQUE</name>
              <description>Opaque: meaning not established.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>BITS_6_21_OPAQUE</name>
              <description>Opaque: meaning not established. Cleared by the reachable STA CCMP enable transaction.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>16</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>65535</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>BITS_22_31_OPAQUE</name>
              <description>Opaque: meaning not established.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>10</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>WORD_000C_OPAQUE</name>
          <description>Opaque: meaning not established. Fourth full-word cold-init store, cleared by complete hal_crypto_init. Its algorithm-specific meaning is not yet recovered.</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BITS_0_31_OPAQUE</name>
              <description>Opaque: meaning not established.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>KEY_VALID_BITMAP</name>
          <description>Project-assigned name. One validity bit per one of the 25 evidenced hardware key entries.</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENTRY_0_VALID</name>
              <description>Project-assigned name. Validity of key-table entry zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENTRY_1_VALID</name>
              <description>Project-assigned name. Validity of key-table entry one.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENTRY_2_VALID</name>
              <description>Project-assigned name. Validity of key-table entry two.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENTRY_3_VALID</name>
              <description>Project-assigned name. Validity of key-table entry three.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENTRY_4_VALID</name>
              <description>Project-assigned name. Validity of key-table entry four.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENTRY_5_VALID</name>
              <description>Project-assigned name. Validity of key-table entry five.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENTRY_6_VALID</name>
              <description>Project-assigned name. Validity of key-table entry six.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENTRY_7_VALID</name>
              <description>Project-assigned name. Validity of key-table entry seven.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENTRY_8_VALID</name>
              <description>Project-assigned name. Validity of key-table entry eight.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
