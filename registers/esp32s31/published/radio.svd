            <field>
              <name>TSF_TIMER_2</name>
              <description>Project-assigned name. Enable the guarded TSF timer-two event.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TSF_TIMER_1</name>
              <description>Project-assigned name. Enable the guarded TSF timer-one event.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TSF_TIMER_0</name>
              <description>Project-assigned name. Enable the guarded TSF timer-zero event.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BITS_8_31_OPAQUE</name>
              <description>Opaque: meaning not established. Enable bits whose event identities remain unknown.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <writeConstraint>
