                  <minimum>0</minimum>
                  <maximum>3</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>BIT_8_OPAQUE</name>
              <description>Opaque: meaning not established.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BITS_10_20_OPAQUE</name>
              <description>Opaque: meaning not established. The complete shared receive initializer replaces bits 10:20 with the finite image 0x79C.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>11</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>2047</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>SHARED_RX_INIT_IMAGE_0</name>
