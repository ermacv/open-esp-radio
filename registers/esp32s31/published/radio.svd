        <register>
          <name>CHANNEL_TX_OFFSET_CONTROL</name>
          <description>Project-assigned name. Canonical multifunction PHY/MAC word. Complete phy_mac_tx_chan_offset and phy_bb_cbw_chan_cfg update the low channel-offset field; complete hal_set_tx_min_pwr updates bits 9:4 and the HE init parent independently sets bit 17.</description>
          <addressOffset>0x4400</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
