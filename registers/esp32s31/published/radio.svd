              <description>Project-assigned name. Second copy of descriptor byte 0x2a written by complete libpp[hal_mac_tx.o]::mac_tx_set_htsig.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>7</bitWidth>
              <writeConstraint>
