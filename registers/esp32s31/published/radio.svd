        </register>
        <register>
          <name>WORD_04A0_OPAQUE</name>
          <description>Opaque: meaning not established. BLE PHY initialization writes a runtime-derived complete image formed from a linked global address. The destination's hardware meaning remains unknown.</description>
          <addressOffset>0x4A0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
