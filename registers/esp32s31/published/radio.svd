                  <maximum>15</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>MINIMUM_POWER_LOW</name>
              <description>Project-assigned name. Low four bits of the signed six-bit minimum-power value. Complete hal_set_tx_min_pwr(-11) writes five. Complete phy_mac_tx_chan_offset and phy_bb_cbw_chan_cfg preserve this field when updating the adjacent channel offset.</description>
