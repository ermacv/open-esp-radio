    <peripheral>
      <name>BLUETOOTH_INTERRUPT_BANK</name>
      <description>Bluetooth controller interrupt programming, enable, status, acknowledgement,
snapshot and diagnostic registers. This physical view is independent from the
controller task lifecycle so ownership can transfer to the hard ISR without
also exposing scheduler, sleep or memory-management state.
</description>
      <baseAddress>0x20101000</baseAddress>
      <registers>
        <register>
          <name>IRQ_CONTROL_0</name>
          <description>Project-assigned name. BTDM interrupt setup and the complete reset leaf write the finite complete image 1. Inner action remains unknown.</description>
