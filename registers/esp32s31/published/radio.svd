                </range>
              </writeConstraint>
            </field>
            <field>
              <name>HT40_MCS</name>
              <description>Project-assigned name.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>15</maximum>
                </range>
              </writeConstraint>
            </field>
