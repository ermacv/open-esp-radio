    <peripheral>
      <name>WIFI_MAC_BEAMFORMING_FEEDBACK_TEST</name>
      <description>Test-only beamforming-feedback selector written by complete esp_test_bf_set_feedback. The write transforms and selector branches are exact; the public meaning of selector values zero through sixteen is not present in the archive, so only bounded functional names are assigned.</description>
      <baseAddress>0x20104E00</baseAddress>
      <registers>
        <register>
          <name>CONFIGURATION</name>
          <description>Project-assigned name. A zero enable argument clears ENABLE only. A nonzero argument first sets ENABLE, clears FEEDBACK_SUBMODE_B, replaces both seven-bit auxiliary arguments, then applies selector-dependent updates to the remaining submode fields. Selector sixteen replaces the complete word with ENABLE plus FEEDBACK_SUBMODE_B value one.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>AUXILIARY_ARGUMENT_LOW</name>
              <description>Project-assigned name. Low seven-bit argument passed as esp_test_bf_set_feedback argument two.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>AUXILIARY_ARGUMENT_HIGH</name>
              <description>Project-assigned name. High seven-bit argument passed as esp_test_bf_set_feedback argument three.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>FEEDBACK_SUBMODE_A</name>
              <description>Project-assigned name. Three-bit selector-dependent field. Complete branches publish one for selector thirteen and five for selector fourteen.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>FEEDBACK_SELECTOR_LOW</name>
              <description>Project-assigned name. For selectors zero through seven this field receives the three-bit selector. The higher selector classes update it only partially or clear it.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>FEEDBACK_SUBMODE_B</name>
              <description>Project-assigned name. Three-bit selector-dependent field. The common enabled prefix clears it; selectors twelve and sixteen publish one.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>ENABLE</name>
              <description>Project-assigned name. A nonzero enable argument sets this bit; zero clears it.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
