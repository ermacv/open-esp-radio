          </fields>
        </register>
        <register>
          <name>TX_QUEUE_INFORMATION_Q7</name>
          <description>Project-assigned name. WDEVTXQ_TXINFO for reverse-addressed hardware queue 7.</description>
          <addressOffset>0x11C0</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>BITS_0_12_OPAQUE</name>
