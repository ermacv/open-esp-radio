    <peripheral>
      <name>PHY_ADC_DUMP_RECOVERED</name>
      <description>Receive sample-dump words programmed by complete librftest adctrig and set_dump_mode. Dumped words are read back from 0x2f060000 as signed ten-bit components in bits 9:0 and 19:10 (complete print_dump_data and sampledeal); that aperture is not radio MMIO.</description>
      <baseAddress>0x20100000</baseAddress>
      <registers>
        <register>
          <name>WORD_08CC_OPAQUE</name>
          <description>Opaque: meaning not established. Complete set_dump_mode clears bits 22:19 in one fresh-read RMW before selecting the dump mode.</description>
          <addressOffset>0x8CC</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BITS_19_22_OPAQUE</name>
              <description>Opaque: meaning not established. Four bits cleared by complete set_dump_mode for every mode.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>WORD_20B4_OPAQUE</name>
          <description>Opaque: meaning not established. One path of the selector jump table of complete adctrig clears bit 0 before programming the dump source; the analysis does not resolve which selector values take that path.</description>
          <addressOffset>0x20B4</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BIT_0_OPAQUE</name>
              <description>Opaque: meaning not established. Cleared by one selector path of complete adctrig.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>WORD_70B8_OPAQUE</name>
          <description>Opaque: meaning not established. Complete set_dump_mode replaces bits 2:0 in one fresh-read RMW.</description>
          <addressOffset>0x70B8</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BITS_0_2_OPAQUE</name>
              <description>Opaque: meaning not established. Complete set_dump_mode writes one for mode zero and zero for every other mode.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>7</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>DUMP_CONTROL</name>
          <description>Project-assigned name. Sample-dump length, start and completion word. Complete adctrig programs LENGTH, clears bits 17 and 21:20, sets ENABLE, pulses TRIGGER for selector zero, polls DONE with a bounded wait and finally clears ENABLE.</description>
          <addressOffset>0x9004</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>LENGTH</name>
              <description>Project-assigned name. Number of dump words: complete adctrig writes its first argument plus one.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>17</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>131071</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>BIT_17_OPAQUE</name>
              <description>Opaque: meaning not established. Cleared by complete adctrig after LENGTH is written.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DONE</name>
              <description>Project-assigned name. Dump completion: complete adctrig polls this bit after starting the dump and stops waiting once it is set or its 1,000,000-count bound of WIFI_MAC_LOCAL_TIME.COUNTER elapses.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TRIGGER</name>
              <description>Project-assigned name. Software dump start: complete adctrig sets and then clears this bit for selector zero after setting ENABLE; selector twelve starts Bluetooth reception instead.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BITS_20_21_OPAQUE</name>
              <description>Opaque: meaning not established. Cleared by complete adctrig before the dump starts.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>ENABLE</name>
              <description>Project-assigned name. Dump enable: complete adctrig sets this bit before starting the dump and clears it after the completion wait.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DUMP_CONFIG</name>
          <description>Project-assigned name. Sample-dump source and rate word. Complete adctrig replaces bits 24:21 at entry, replaces SOURCE_SELECT on one selector path and reads the whole word after the completion wait.</description>
          <addressOffset>0x9008</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BITS_0_15_OPAQUE</name>
              <description>Opaque: meaning not established. Read by complete adctrig after the completion wait; it prints the low sixteen bits.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>SOURCE_SELECT</name>
              <description>Project-assigned name. Dump source: one selector path of complete adctrig replaces these bits with its selector argument.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>4</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>15</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>BITS_21_24_OPAQUE</name>
              <description>Opaque: meaning not established. Complete adctrig writes half its fourth argument, or zero when that argument is below two.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>4</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>15</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>DUMP_LANE_SELECT</name>
          <description>Project-assigned name. Four six-bit dump lane selectors and an enable bit, programmed by complete adctrig: 24, 25, 26 and 27 by default, with other values for selector arguments 11 and 12.</description>
          <addressOffset>0x9018</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>LANE_0</name>
              <description>Project-assigned name. First lane selector; complete adctrig writes 24 by default.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>63</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>LANE_1</name>
              <description>Project-assigned name. Second lane selector; complete adctrig writes 25 by default.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>6</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>63</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>LANE_2</name>
              <description>Project-assigned name. Third lane selector; complete adctrig writes 26 by default.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>6</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>63</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>LANE_3</name>
              <description>Project-assigned name. Fourth lane selector; complete adctrig writes 27 by default.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>6</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>63</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>BIT_24_OPAQUE</name>
              <description>Opaque: meaning not established. Set by complete adctrig after the lane selectors.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
