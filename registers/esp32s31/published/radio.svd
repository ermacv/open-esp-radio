              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
            </field>
            <field>
              <name>RX_PS_ENABLE</name>
              <description>Project-assigned name.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>STOP_RF</name>
              <description>Project-assigned name.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PS_READY</name>
              <description>Project-assigned name.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FE_FREQUENCY_HOP_TIME</name>
              <description>Project-assigned name.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>BITS_21_22_OPAQUE</name>
              <description>Opaque: meaning not established.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>RX_PHY_SIGNAL_DELAY</name>
              <description>Project-assigned name.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
            <field>
              <name>INTRA_PS_CHECK_BSS_COLOR_ENABLE</name>
              <description>Project-assigned name. Complete hal_he_set_power_save sets bit 28 for interface zero as the final fresh-read RMW of hal_he_bssid_init; dbg_read_rx_misc names it INTRA_PS_CHECK_BSS_COLOR.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRA_PPDU_PS_ENABLE</name>
