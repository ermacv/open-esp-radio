      <name>BTMAC_BLE_PHY_INIT</name>
      <description>ESP32-S31 BTMAC words initialized by the complete BLE PHY register-init
function. The function identity is supported by the matching ble_phy.c object
layout from the ESP32-C61 ecosystem library, while every address, mask and
value below comes only from the ESP32-S31 artifact. Neutral INIT names retain
the exact operation without promoting the cross-chip hint to hardware truth.</description>
      <baseAddress>0x20101400</baseAddress>
      <registers>
        <register>
          <name>WORD_0074_OPAQUE</name>
          <description>Opaque: meaning not established. BLE PHY register initialization writes the complete zero image. Inner hardware semantics remain unknown.</description>
          <addressOffset>0x74</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BITS_0_31_OPAQUE</name>
              <description>Opaque: meaning not established.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>INTERRUPT_ENABLE</name>
          <description>Project-assigned name. BLE base-stack interrupt enable bank. BLE PHY initialization preserves only source 17. The synchronous scheduler-run subscriber clears stale source 14 before enabling it here. All omitted source identities remain unknown.</description>
          <addressOffset>0xB4</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SCHEDULER_RUN</name>
              <description>Project-assigned name. The synchronous base-stack subscriber enables source 14 immediately before the scheduler RUN command.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SOURCE_17</name>
              <description>Project-assigned name. BLE PHY initialization preserves source 17 while disabling every other interrupt source. Its feature identity remains unknown.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>INTERRUPT_CLEAR</name>
          <description>Project-assigned name. Write-one-to-clear BLE base-stack interrupt bank. Initialization acknowledges every source with an all-ones image; the synchronous scheduler-run subscriber acknowledges source 14 before enabling it.</description>
          <addressOffset>0xB8</addressOffset>
          <size>0x20</size>
          <access>write-only</access>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>
          <fields>
            <field>
              <name>SCHEDULER_RUN</name>
              <description>Project-assigned name. A one acknowledges stale scheduler-run source 14 before that source is enabled.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>WORD_0138_OPAQUE</name>
          <description>Opaque: meaning not established. BLE PHY register initialization writes the finite complete image 0x0000065B.</description>
          <addressOffset>0x138</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BITS_0_31_OPAQUE</name>
              <description>Opaque: meaning not established.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LC_TX_ON_DELAY_CONFIG</name>
          <description>Project-assigned name. BLE transmit timing configuration. ble_tx_config_check independently prints byte zero as lc_tx_on_delay; BLE PHY initialization writes the same runtime-derived byte image into bytes zero and two.</description>
          <addressOffset>0x250</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>LC_TX_ON_DELAY</name>
              <description>Project-assigned name. Low byte printed as lc_tx_on_delay by complete ble_tx_config_check. BLE PHY initialization stores a configuration byte minus one.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>INIT_DUPLICATE_BYTE</name>
              <description>Project-assigned name. BLE PHY initialization receives the same configuration-byte-minus-one image as LC_TX_ON_DELAY. No independent semantic name is claimed.</description>
