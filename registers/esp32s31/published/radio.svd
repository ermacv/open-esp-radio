              <description>Project-assigned name. Use the software HE_CONTROL word instead of the hardware-generated HE-Control value.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
