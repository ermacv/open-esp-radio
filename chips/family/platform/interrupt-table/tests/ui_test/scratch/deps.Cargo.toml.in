# What a case may name: `ui_test` lends the cases this package's normal
# dependencies, built with the features written here.
[package]
name = "ui-test-trial-deps"
version = "0.0.0"
edition = "2024"
publish = false

[lib]
path = "lib.rs"

[dependencies]
oer-chips-family-platform-interrupt-table = { path = "../../../chips/family/platform/interrupt-table", features = ["host-signal"] }
