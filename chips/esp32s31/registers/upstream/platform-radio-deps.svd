    <peripheral>
      <name>EFUSE</name>
      <description>SOURCE[ESP32S31_PAC_D0FB94E]. Platform-owned eFuse controller. Only the two exact read-only MAC words reached by the PHY ROM call graph are mirrored here.</description>
      <baseAddress>0x20715000</baseAddress>
      <registers>
        <register>
          <name>RD_MAC_SYS0</name>
          <description>SOURCE[ESP32S31_PAC_D0FB94E]. Exact platform-PAC register and field: low 32 bits of the system MAC address.</description>
          <addressOffset>0x50</addressOffset><size>32</size><access>read-only</access>
          <fields>
            <field><name>MAC_0</name><bitOffset>0</bitOffset><bitWidth>32</bitWidth><access>read-only</access></field>
          </fields>
        </register>
        <register>
          <name>RD_MAC_SYS1</name>
          <description>SOURCE[ESP32S31_PAC_D0FB94E]. Exact platform-PAC register and fields: high 16 system-MAC bits and the 16 extended MAC bits.</description>
          <addressOffset>0x54</addressOffset><size>32</size><access>read-only</access>
          <fields>
            <field><name>MAC_1</name><bitOffset>0</bitOffset><bitWidth>16</bitWidth><access>read-only</access></field>
            <field><name>MAC_EXT</name><bitOffset>16</bitOffset><bitWidth>16</bitWidth><access>read-only</access></field>
          </fields>
        </register>
      </registers>
