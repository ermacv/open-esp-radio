# Register publication outputs (`cargo registers generate`): never edited by
# hand. The raw PACs and binding indexes are derived from the SVD, which stays
# diffable; `git diff --text` shows them when needed.
chips/*/*pac-raw/src/lib.rs linguist-generated=true -diff
chips/*/*pac/src/generated.rs linguist-generated=true
chips/*/registers/published/*.svd linguist-generated=true
chips/*/registers/published/*.bindings.toml linguist-generated=true -diff
# Machine-written vendor fact registries: function fingerprints and recovered
# name maps.
chips/*/vendor/facts/provenance.toml linguist-generated=true
chips/*/vendor/facts/names/*.toml linguist-generated=true
