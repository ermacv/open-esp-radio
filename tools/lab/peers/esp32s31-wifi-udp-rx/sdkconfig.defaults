CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
# Warnings name a refused vendor call; the host reads only protocol lines.
# INFO stays compiled in for the vendor's statistics dump (`DUMP`).
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
# The stand's S31 carries 16 MB of flash; the bootloader this image writes
# must describe it, or the HIL images the other owners flash do not boot.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# The HIL flash layout: the application occupies ota_0 of the shared table.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../chips/esp32s31/facts/partitions/applications.csv"
# The digest depends only on the sources.
CONFIG_APP_REPRODUCIBLE_BUILD=y
# The stand reaches the device through its USB Serial/JTAG port, which
# carries the console in both directions.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Nothing of a run outlives it: no stored Wi-Fi configuration.
CONFIG_ESP_WIFI_NVS_ENABLED=n
# The open station's receive side: a 16-MPDU Block Ack reorder window and
# 32 large receive slots beside its DMA ring.
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
# The vendor's own receive counts (`REPORT`).
CONFIG_ESP_WIFI_ENABLE_WIFI_RX_STATS=y
# The IP stack's queues as ESP-IDF's iperf example sets them for the
# ESP32-S31, so the socket does not limit the receiver; its counts name
# where a datagram was dropped above the driver.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_STATS=y
